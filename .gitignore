# Dev stuff
__pycache__
*.sw?
.idea/
# Locally generated
# we highly recommended against removing the private folder from the gitignore file
# the directory is used to store sensitive information such as contacts
/private
.vscode/settings.json
.DS_Store
*.bak
# Emacs (from https://github.com/github/gitignore/blob/main/Global/Emacs.gitignore)
*~
\#*\#
.\#*
# Vim (from https://github.com/github/gitignore/blob/main/Global/Vim.gitignore)
[._]*.swp
# Runtime state files
saved_windows.json
mode_indicator_state.json
usage_log.csv
# Snapshot/reconciliation artifacts
.scripts/collisions/
.scripts/talon-snapshot-*.json
.scripts/reconcile-*.md

# Beads / Dolt files
.dolt/
*.db
.beads-credential-key
.beads/

# Gas Town (added by gt)
.runtime/
.claude/commands/
.logs/

# Node tool caches. There is no node build here, but the repo's prettier pre-commit hook
# writes its cache to node_modules/.cache/prettier/, which otherwise shows up as
# untracked junk after `pre-commit run --all-files`.
node_modules/

# Rust build output
target/

# smooth_scroll runtime state and recordings
plugin/smooth_scroll/hold.touch
plugin/smooth_scroll/*.json
plugin/smooth_scroll/*.jsonl

# per-host path lists (machine-local)
core/system_paths-*

# mode_indicator personal/machine-local state
trillium/plugin/mode_indicator/subscription_end.json
trillium/plugin/mode_indicator/subscription_override.json
trillium/plugin/mode_indicator/subscription_status_log.csv
trillium/plugin/mode_indicator/accounts.json
trillium/plugin/mode_indicator/interceptor-screenshot-*.png

# external symlink
trillium/plugin/prose_overlay

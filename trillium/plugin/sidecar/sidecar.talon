sidecar back: user.sidecar_back()
sidecar pane {user.sidecar_pane}: user.sidecar_set_pane(sidecar_pane)
sidecar list: user.sidecar_list("panes")
sidecar views: user.sidecar_list_views()
sidecar controls: user.sidecar_list("controls")
sidecar requests: user.sidecar_list("requests")

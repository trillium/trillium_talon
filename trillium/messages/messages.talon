app: messages
-
[go] (convo | tab) next:
    key(ctrl-tab)

[go] (convo | tab) previous:
    key(ctrl-shift-tab)

edit last [message]:
    key(cmd-e)

reply last [message]:
    key(cmd-r)

mark [as] unread:
    key(cmd-shift-u)

view unread [messages]:
    key(cmd-shift-i)

view all [messages]:
    key(ctrl-cmd-1)

view known [messages]:
    key(ctrl-cmd-2)

view unknown [messages]:
    key(ctrl-cmd-3)

# view unread [messages]:
#     key(ctrl-cmd-4)

view deleted [messages]:
    key(ctrl-cmd-5)

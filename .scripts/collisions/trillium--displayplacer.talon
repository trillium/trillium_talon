mode: command
-

display save <user.text>: user.display_save_profile(text)
display load <user.text>: user.display_load_profile(text)
display profiles: user.display_list_profiles()
display delete <user.text>: user.display_delete_profile(text)
display show current: user.display_show_current()
display close: user.display_hide_profiles()

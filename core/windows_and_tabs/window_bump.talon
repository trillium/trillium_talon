tag: user.window_bumping
-
bump left: user.window_bump("left")
bump right: user.window_bump("right")
bump left <number_small>: user.window_bump("left", number_small)
bump right <number_small>: user.window_bump("right", number_small)
widen: user.window_resize("widen")
narrow: user.window_resize("narrow")
widen <number_small>: user.window_resize("widen", number_small)
narrow <number_small>: user.window_resize("narrow", number_small)
bump settings: user.window_bump_show_settings()
